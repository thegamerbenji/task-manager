<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tasks</title>
<style>
  :root{
    --bg: #f6f5f1;
    --surface: #ffffff;
    --ink: #23262b;
    --ink-soft: #767a82;
    --line: #e6e3db;
    --school: #4c6b8a;
    --school-soft: #eaf0f5;
    --projects: #5c7a53;
    --projects-soft: #eef2ea;
    --danger: #b5544a;
    --planning: #4c6b8a;
    --progress: #c99a3d;
    --done: #6b9080;
    --pri-low: #8a94a3;
    --pri-medium: #c99a3d;
    --pri-high: #b5544a;
    --accent: var(--school);
    --accent-soft: var(--school-soft);
  }

  html[data-theme="dark"]{
    --bg: #1b1c1e;
    --surface: #26282b;
    --ink: #ecebe7;
    --ink-soft: #9a9c9f;
    --line: #38393c;
    --school: #7fa4c7;
    --school-soft: #2a3540;
    --projects: #8bab7f;
    --projects-soft: #2a3527;
    --danger: #d17a70;
    --planning: #7fa4c7;
    --progress: #d9ae5c;
    --done: #8bab7f;
    --pri-low: #7d858f;
    --pri-medium: #d9ae5c;
    --pri-high: #d17a70;
  }

  *{ box-sizing:border-box; }

  html,body{
    margin:0;
    padding:0;
    background:var(--bg);
    color:var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow-x:hidden;
    transition: background .25s ease, color .25s ease;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
  }

  .theme-toggle{
    position: fixed;
    top: 18px;
    right: 18px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    cursor: pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size: 15px;
    z-index: 50;
    transition: transform .2s cubic-bezier(.34,1.56,.64,1), color .2s ease, border-color .2s ease;
  }
  .theme-toggle:hover{ color: var(--ink); border-color: var(--ink-soft); transform: rotate(20deg); }

  /* ---------- Gate screen ---------- */
  .gate{
    min-height: 100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding: 24px;
    transition: opacity .45s ease, transform .45s ease;
  }
  .gate.leaving{ opacity: 0; transform: scale(.97); pointer-events: none; }

  .gate-title{
    font-size: 15px;
    color: var(--ink-soft);
    letter-spacing: .02em;
    margin-bottom: 28px;
    opacity: 0;
    animation: riseIn .5s ease forwards;
  }

  .gate-cards{ display:flex; gap: 20px; flex-wrap: wrap; justify-content:center; }

  .gate-card{
    width: 230px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 32px 24px;
    cursor: pointer;
    text-align:left;
    display:flex;
    flex-direction:column;
    gap: 14px;
    opacity: 0;
    transform: translateY(14px);
    animation: riseIn .55s ease forwards;
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .gate-card:nth-child(1){ animation-delay: .05s; }
  .gate-card:nth-child(2){ animation-delay: .15s; }
  .gate-card:hover{ transform: translateY(-4px); box-shadow: 0 14px 30px -18px rgba(0,0,0,0.3); }
  .gate-card:active{ transform: translateY(-1px) scale(.99); }
  .gate-card .dot{ width:14px; height:14px; border-radius:50%; }
  .gate-card.school:hover{ border-color: var(--school); }
  .gate-card.projects:hover{ border-color: var(--projects); }
  .gate-card h3{ margin:0; font-size: 17px; font-weight: 650; letter-spacing: -0.01em; }
  .gate-card p{ margin:0; font-size: 13px; color: var(--ink-soft); line-height: 1.5; }

  @keyframes riseIn{ to{ opacity:1; transform: translateY(0); } }

  /* ---------- Board ---------- */
  .app{
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 24px 80px;
    opacity: 0;
    transform: translateY(10px);
  }
  .app.entering{ animation: boardIn .45s ease forwards; }
  @keyframes boardIn{ to{ opacity:1; transform: translateY(0); } }

  header.top{
    display:flex;
    align-items:center;
    gap: 12px;
    margin-bottom: 24px;
  }

  .back-btn{
    border:none;
    background:none;
    color: var(--ink-soft);
    font-size: 18px;
    cursor:pointer;
    padding: 4px 6px;
    border-radius: 8px;
    line-height:1;
    transition: background .15s ease, color .15s ease;
  }
  .back-btn:hover{ background: var(--surface); color: var(--ink); }

  header.top h1{
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin:0;
    display:flex;
    align-items:center;
    gap:9px;
    flex:1;
  }

  .switch-btn{
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-size: 12.5px;
    font-weight: 550;
    padding: 7px 12px;
    border-radius: 20px;
    cursor:pointer;
    display:flex;
    align-items:center;
    gap:7px;
    transition: border-color .15s ease, color .15s ease, transform .15s ease;
  }
  .switch-btn:hover{ color: var(--ink); border-color: var(--ink-soft); transform: translateY(-1px); }
  .switch-btn .dot{ width:7px; height:7px; border-radius:50%; }

  .connect-btn{
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-soft);
    font-size: 12.5px;
    font-weight: 550;
    padding: 7px 12px;
    border-radius: 20px;
    cursor:pointer;
    transition: border-color .15s ease, color .15s ease, transform .15s ease;
  }
  .connect-btn:hover{ color: var(--ink); border-color: var(--ink-soft); transform: translateY(-1px); }
  .connect-btn.on{ color: var(--accent); border-color: var(--accent); }

  .connect-panel{
    display:none;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 22px;
  }
  .connect-panel.open{ display:grid; animation: taskIn .25s ease both; }
  @media (max-width: 720px){ .connect-panel{ grid-template-columns: 1fr; } }

  .connect-card{
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px;
  }
  .connect-card h3{
    margin: 0 0 4px;
    font-size: 13.5px;
    font-weight: 650;
    display:flex;
    align-items:center;
    gap:7px;
  }
  .connect-card p.hint{
    margin: 0 0 10px;
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .connect-row{ display:flex; gap:8px; }
  .connect-row input[type="text"]{
    flex:1;
    min-width:0;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    font-family: inherit;
    background: var(--bg);
    color: var(--ink);
    outline:none;
  }
  .connect-row input[type="text"]:focus{ border-color: var(--accent); }
  .connect-row textarea{
    flex:1;
    min-width:0;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 13px;
    font-family: inherit;
    background: var(--bg);
    color: var(--ink);
    outline:none;
    resize: vertical;
    min-height: 60px;
  }
  .connect-row textarea:focus{ border-color: var(--accent); }
  .connect-go{
    border:none;
    background: var(--ink);
    color: var(--bg);
    font-size: 12.5px;
    font-weight: 600;
    padding: 0 14px;
    border-radius: 8px;
    cursor:pointer;
    flex-shrink:0;
    transition: opacity .12s ease;
  }
  .connect-go:hover{ opacity:.85; }
  .connect-status{
    margin-top: 8px;
    font-size: 11.5px;
    color: var(--ink-soft);
    min-height: 14px;
  }
  .connect-status.error{ color: var(--danger); }

  .task-badge{
    display:inline-flex;
    align-items:center;
    gap:3px;
    font-size: 10.5px;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 1px 6px;
    border-radius: 20px;
    margin-bottom: 5px;
  }

  .badge-row{
    display:flex;
    flex-wrap:wrap;
    gap:5px;
    margin-bottom: 5px;
  }
  .badge-row .task-badge{ margin-bottom: 0; }

  .priority-pill{
    display:inline-flex;
    align-items:center;
    gap:4px;
    font-size: 10.5px;
    font-weight: 650;
    padding: 1px 7px 1px 5px;
    border-radius: 20px;
    border: 1px solid transparent;
    cursor: pointer;
    background: none;
    user-select:none;
    transition: transform .12s ease;
  }
  .priority-pill:hover{ transform: scale(1.05); }
  .priority-pill .flag-dot{ width:6px; height:6px; border-radius:50%; flex-shrink:0; }

  .priority-cycle{
    border: 1px solid var(--line);
    background: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size: 12px;
    flex-shrink:0;
    transition: transform .15s cubic-bezier(.34,1.56,.64,1), border-color .15s ease;
  }
  .priority-cycle:hover{ transform: scale(1.1); }

  .columns{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    align-items: start;
  }
  @media (max-width: 820px){
    .columns{ grid-template-columns: 1fr; }
  }

  .col{
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px;
    min-height: 160px;
    transition: background .25s ease, border-color .25s ease;
  }

  .col-head{
    display:flex;
    align-items:center;
    gap:9px;
    margin-bottom: 14px;
  }
  .col-head .dot{ width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .col-head h2{ font-size: 13.5px; font-weight: 650; margin:0; flex:1; letter-spacing: -0.005em; }
  .col-count{
    font-size: 11.5px;
    color: var(--ink-soft);
    background: var(--bg);
    padding: 2px 8px;
    border-radius: 20px;
  }

  .task-list{
    display:flex;
    flex-direction:column;
    gap:8px;
    min-height: 30px;
  }
  .task-list.drag-over{
    background: rgba(120,120,120,0.06);
    border-radius: 10px;
    outline: 1.5px dashed var(--line);
    outline-offset: 3px;
  }

  .task{
    border: 1px solid var(--line);
    border-left-width: 3px;
    border-radius: 10px;
    padding: 10px 10px 10px 8px;
    display:flex;
    gap:8px;
    align-items:flex-start;
    background: var(--bg);
    cursor: grab;
    transform-origin: top center;
    animation: taskIn .3s cubic-bezier(.2,.8,.3,1) both;
    transition: box-shadow .18s ease, opacity .18s ease, transform .18s ease, background .25s ease, border-color .25s ease;
  }
  @keyframes taskIn{
    from{ opacity:0; transform: translateY(-8px) scale(.98); }
    to{ opacity:1; transform: translateY(0) scale(1); }
  }
  .task.removing{ animation: taskOut .22s ease forwards; }
  @keyframes taskOut{
    to{ opacity:0; transform: translateX(14px) scale(.96); margin-bottom:-8px; padding-top:0; padding-bottom:0; max-height:0; }
  }

  .task:hover{ box-shadow: 0 8px 20px -16px rgba(0,0,0,0.35); }
  .task:active{ cursor:grabbing; }
  .task.dragging{ opacity: .35; }
  .task.status-done .task-text{ text-decoration: line-through; color: var(--ink-soft); }

  .handle{
    color: var(--line);
    font-size: 13px;
    line-height: 1;
    padding: 3px 2px 0 0;
    user-select:none;
    flex-shrink:0;
  }

  .task-body{ flex:1; min-width:0; }

  .task-text{
    font-size: 13.5px;
    line-height: 1.4;
    word-break: break-word;
    outline:none;
    padding: 1px 0;
  }
  .task-text[contenteditable="true"]{ border-bottom: 1px solid var(--line); }

  .task-img{
    margin-top: 8px;
    max-width: 100%;
    max-height: 130px;
    border-radius: 8px;
    display:block;
    cursor: zoom-in;
    border: 1px solid var(--line);
    transition: transform .2s ease;
  }
  .task-img:hover{ transform: scale(1.015); }

  .task-actions{
    display:flex;
    gap: 4px;
    flex-shrink:0;
    opacity: 0;
    transform: translateX(4px);
    transition: opacity .15s ease, transform .15s ease;
  }
  .task:hover .task-actions{ opacity: 1; transform: translateX(0); }

  .icon-btn{
    background:none;
    border:none;
    color: var(--ink-soft);
    cursor:pointer;
    padding: 3px;
    font-size: 12px;
    line-height:1;
    border-radius: 5px;
    transition: background .12s ease, color .12s ease;
  }
  .icon-btn:hover{ background: var(--surface); color: var(--ink); }
  .icon-btn.remove:hover{ color: var(--danger); }

  /* ---------- Expanding add control ---------- */
  .add-control{
    margin-top: 12px;
    display:flex;
    align-items:center;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    height: 36px;
    width: 36px;
    transition: width .28s cubic-bezier(.2,.8,.2,1), background .25s ease, border-color .25s ease;
  }
  .add-control.expanded{ width: 100%; }

  .add-plus{
    width: 34px;
    height: 34px;
    flex-shrink:0;
    border:none;
    background: none;
    color: var(--ink);
    font-size: 18px;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    transition: transform .2s cubic-bezier(.34,1.56,.64,1);
  }
  .add-control.expanded .add-plus{ transform: rotate(45deg); color: var(--danger); }
  .add-plus:hover{ transform: scale(1.1); }
  .add-control.expanded .add-plus:hover{ transform: rotate(45deg) scale(1.1); }

  .add-fields{
    display:flex;
    align-items:center;
    flex:1;
    min-width: 0;
    opacity: 0;
    transition: opacity .18s ease .08s;
  }
  .add-control.expanded .add-fields{ opacity: 1; }

  .add-fields input[type="text"]{
    flex:1;
    min-width: 0;
    border:none;
    background: transparent;
    font-family: inherit;
    font-size: 13px;
    color: var(--ink);
    outline:none;
    padding: 0 4px;
  }

  .add-fields button{
    border:none;
    background:none;
    color: var(--ink-soft);
    cursor:pointer;
    font-size: 14px;
    padding: 4px 8px;
    flex-shrink:0;
    border-radius: 50%;
    transition: color .12s ease, background .12s ease;
  }
  .add-fields button:hover{ color: var(--ink); background: var(--surface); }
  .add-fields .confirm-btn.pending-img{ color: var(--accent); }

  .empty-hint{
    font-size: 12.5px;
    color: var(--ink-soft);
    padding: 14px 2px;
    text-align:center;
  }

  .lightbox{
    position: fixed;
    inset:0;
    background: rgba(10,10,10,0.85);
    display:none;
    align-items:center;
    justify-content:center;
    z-index: 999;
    padding: 40px;
    animation: fadeIn .2s ease;
  }
  @keyframes fadeIn{ from{opacity:0;} to{opacity:1;} }
  .lightbox.open{ display:flex; }
  .lightbox img{ max-width: 100%; max-height: 100%; border-radius: 10px; animation: riseIn .25s ease; }

  ::selection{ background: var(--accent-soft); }
</style>
</head>
<body>

<button class="theme-toggle" id="theme-toggle" title="Toggle dark mode">🌙</button>

<div class="gate" id="gate">
  <div class="gate-title" id="gate-title">Pick a board to open</div>
  <div class="gate-cards">
    <div class="gate-card school" data-group="school">
      <span class="dot" style="background:var(--school)"></span>
      <h3>School</h3>
      <p>Assignments, readings, deadlines.</p>
    </div>
    <div class="gate-card projects" data-group="projects">
      <span class="dot" style="background:var(--projects)"></span>
      <h3>My Projects</h3>
      <p>Everything you're building on your own.</p>
    </div>
  </div>
</div>

<div class="app" id="app" style="display:none;">
  <header class="top">
    <button class="back-btn" id="back-btn" title="Back to boards">←</button>
    <h1><span class="dot" id="active-dot" style="width:9px;height:9px;border-radius:50%;"></span><span id="active-title"></span></h1>
    <button class="switch-btn" id="switch-btn">
      <span class="dot"></span>
      <span id="switch-label"></span>
    </button>
    <button class="connect-btn" id="connect-btn">Connect</button>
  </header>

  <div class="connect-panel" id="connect-panel">
    <div class="connect-card">
      <h3>🐙 GitHub</h3>
      <p class="hint">Pull open issues from any public repo in as tasks (read-only, no login needed).</p>
      <div class="connect-row">
        <input type="text" id="github-repo" placeholder="owner/repo, e.g. facebook/react">
        <button class="connect-go" id="github-go">Import</button>
      </div>
      <div class="connect-status" id="github-status"></div>
    </div>
    <div class="connect-card">
      <h3>🎓 Google Classroom</h3>
      <p class="hint">Google doesn't allow live sync from a page like this — paste your assignment list instead and it'll turn each line into a task.</p>
      <div class="connect-row">
        <textarea id="classroom-paste" placeholder="One assignment per line…"></textarea>
      </div>
      <div class="connect-row" style="margin-top:6px; justify-content:flex-end;">
        <button class="connect-go" id="classroom-go" style="flex:none;">Import lines</button>
      </div>
      <div class="connect-status" id="classroom-status"></div>
    </div>
  </div>

  <div class="columns" id="columns"></div>
</div>

<div class="lightbox" id="lightbox">
  <img id="lightbox-img" src="" alt="attachment preview">
</div>

<input type="file" accept="image/*" id="shared-file-input" style="display:none">

<script>
(function(){
  let idCounter = 1;
  const STATUSES = [
    { key: 'planning', label: 'Planning', color: 'var(--planning)' },
    { key: 'progress', label: 'In Progress', color: 'var(--progress)' },
    { key: 'done', label: 'Done', color: 'var(--done)' }
  ];
  const PRIORITY_ORDER = ['low', 'medium', 'high'];
  const PRIORITY_META = {
    low:    { label: 'Low',    color: 'var(--pri-low)' },
    medium: { label: 'Medium', color: 'var(--pri-medium)' },
    high:   { label: 'High',   color: 'var(--pri-high)' }
  };

  const state = {
    school: [
      { id:'seed1', text:'Finish reading chapter 4', status:'planning', image:null, priority:'medium' },
      { id:'seed2', text:'Math problem set due Friday', status:'progress', image:null, priority:'high' }
    ],
    projects: [
      { id:'seed3', text:'Sketch UI for new addon', status:'planning', image:null, priority:'low' }
    ]
  };
  const meta = {
    school: { label: 'School', color: 'var(--school)', soft: 'var(--school-soft)' },
    projects: { label: 'My Projects', color: 'var(--projects)', soft: 'var(--projects-soft)' }
  };
  let activeGroup = null;

  function uid(){ return 't' + (idCounter++); }

  const gate = document.getElementById('gate');
  const app = document.getElementById('app');
  const columnsEl = document.getElementById('columns');
  const switchBtn = document.getElementById('switch-btn');
  const switchLabel = document.getElementById('switch-label');
  const activeTitle = document.getElementById('active-title');
  const activeDot = document.getElementById('active-dot');
  const backBtn = document.getElementById('back-btn');
  const themeToggle = document.getElementById('theme-toggle');
  const sharedFileInput = document.getElementById('shared-file-input');
  const connectBtn = document.getElementById('connect-btn');
  const connectPanel = document.getElementById('connect-panel');
  const githubRepoInput = document.getElementById('github-repo');
  const githubGoBtn = document.getElementById('github-go');
  const githubStatus = document.getElementById('github-status');
  const classroomPaste = document.getElementById('classroom-paste');
  const classroomGoBtn = document.getElementById('classroom-go');
  const classroomStatus = document.getElementById('classroom-status');

  connectBtn.addEventListener('click', () => {
    connectPanel.classList.toggle('open');
    connectBtn.classList.toggle('on');
  });

  githubGoBtn.addEventListener('click', async () => {
    const repo = githubRepoInput.value.trim().replace(/^\/|\/$/g, '');
    if(!repo || !repo.includes('/')){
      githubStatus.textContent = 'Enter it as owner/repo, e.g. facebook/react';
      githubStatus.classList.add('error');
      return;
    }
    githubStatus.classList.remove('error');
    githubStatus.textContent = 'Fetching open issues…';
    githubGoBtn.disabled = true;
    try{
      const res = await fetch('https://api.github.com/repos/' + repo + '/issues?state=open&per_page=15');
      if(!res.ok){
        throw new Error(res.status === 404 ? 'Repo not found (must be public)' : 'GitHub error (' + res.status + ')');
      }
      const issues = await res.json();
      const realIssues = issues.filter(i => !i.pull_request);
      if(realIssues.length === 0){
        githubStatus.textContent = 'No open issues found on that repo.';
      } else {
        realIssues.forEach(issue => {
          state[activeGroup].push({
            id: uid(),
            text: '#' + issue.number + ' ' + issue.title,
            status: 'planning',
            image: null,
            priority: 'medium',
            source: 'github',
            url: issue.html_url
          });
        });
        githubStatus.textContent = 'Imported ' + realIssues.length + ' issue(s) into Planning.';
        renderBoard();
      }
    } catch(err){
      githubStatus.classList.add('error');
      githubStatus.textContent = err.message || 'Could not reach GitHub.';
    } finally {
      githubGoBtn.disabled = false;
    }
  });

  classroomGoBtn.addEventListener('click', () => {
    const lines = classroomPaste.value.split('\n').map(l => l.trim()).filter(Boolean);
    if(lines.length === 0){
      classroomStatus.classList.add('error');
      classroomStatus.textContent = 'Paste at least one assignment line first.';
      return;
    }
    classroomStatus.classList.remove('error');
    lines.forEach(line => {
      state[activeGroup].push({
        id: uid(),
        text: line,
        status: 'planning',
        image: null,
        priority: 'medium',
        source: 'classroom',
        url: null
      });
    });
    classroomStatus.textContent = 'Imported ' + lines.length + ' item(s) into Planning.';
    classroomPaste.value = '';
    renderBoard();
  });

  // ---------- shared file input (single persistent instance) ----------
  let pendingFileCallback = null;
  sharedFileInput.addEventListener('change', () => {
    const f = sharedFileInput.files[0];
    if(f && pendingFileCallback){
      const reader = new FileReader();
      reader.onload = () => { if(pendingFileCallback) pendingFileCallback(reader.result); pendingFileCallback = null; };
      reader.onerror = () => { console.error('Could not read image file'); pendingFileCallback = null; };
      reader.readAsDataURL(f);
    }
    sharedFileInput.value = '';
  });
  function pickImage(cb){
    pendingFileCallback = cb;
    sharedFileInput.click();
  }
  function readDroppedImage(file, cb){
    const reader = new FileReader();
    reader.onload = () => cb(reader.result);
    reader.readAsDataURL(file);
  }

  // ---------- theme ----------
  themeToggle.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
    themeToggle.textContent = isDark ? '🌙' : '☀️';
  });

  // ---------- gate ----------
  document.querySelectorAll('.gate-card').forEach(card => {
    card.addEventListener('click', () => openBoard(card.dataset.group));
  });

  function openBoard(group){
    activeGroup = group;
    gate.classList.add('leaving');
    setTimeout(() => {
      gate.style.display = 'none';
      app.style.display = 'block';
      void app.offsetWidth;
      app.classList.add('entering');
      setActiveGroupUI();
      renderBoard();
    }, 420);
  }

  function setActiveGroupUI(){
    const m = meta[activeGroup];
    const other = activeGroup === 'school' ? 'projects' : 'school';
    const om = meta[other];
    document.documentElement.style.setProperty('--accent', m.color);
    document.documentElement.style.setProperty('--accent-soft', m.soft);
    activeTitle.textContent = m.label;
    activeDot.style.background = m.color;
    switchLabel.textContent = om.label;
    switchBtn.querySelector('.dot').style.background = om.color;
  }

  switchBtn.addEventListener('click', () => {
    const other = activeGroup === 'school' ? 'projects' : 'school';
    app.style.transition = 'opacity .2s ease, transform .2s ease';
    app.style.opacity = '0';
    app.style.transform = 'translateY(6px)';
    setTimeout(() => {
      activeGroup = other;
      setActiveGroupUI();
      renderBoard();
      app.style.opacity = '1';
      app.style.transform = 'translateY(0)';
    }, 200);
  });

  backBtn.addEventListener('click', () => {
    app.classList.remove('entering');
    app.style.opacity = '0';
    app.style.transform = 'translateY(10px)';
    setTimeout(() => {
      app.style.display = 'none';
      gate.style.display = 'flex';
      gate.classList.remove('leaving');
      gate.querySelectorAll('.gate-card, .gate-title').forEach(el => {
        el.style.animation = 'none';
        void el.offsetWidth;
        el.style.animation = '';
      });
    }, 200);
  });

  // ---------- board / columns ----------
  function renderBoard(){
    columnsEl.innerHTML = '';
    STATUSES.forEach(st => columnsEl.appendChild(buildColumn(st)));
  }

  function buildColumn(st){
    const tasks = state[activeGroup].filter(t => t.status === st.key);

    const col = document.createElement('div');
    col.className = 'col';
    col.dataset.status = st.key;

    const head = document.createElement('div');
    head.className = 'col-head';
    head.innerHTML =
      '<span class="dot" style="background:' + st.color + '"></span>' +
      '<h2>' + st.label + '</h2>' +
      '<span class="col-count">' + tasks.length + '</span>';
    col.appendChild(head);

    const list = document.createElement('div');
    list.className = 'task-list';
    list.dataset.status = st.key;

    if(tasks.length === 0){
      const hint = document.createElement('div');
      hint.className = 'empty-hint';
      hint.textContent = 'Nothing here.';
      list.appendChild(hint);
    } else {
      tasks.forEach(task => list.appendChild(buildTaskEl(task)));
    }
    col.appendChild(list);
    wireDropZone(list, st.key);

    col.appendChild(buildAddControl(st.key));

    return col;
  }

  function wireDropZone(list, statusKey){
    list.addEventListener('dragover', (e) => {
      e.preventDefault();
      list.classList.add('drag-over');
    });
    list.addEventListener('dragleave', () => list.classList.remove('drag-over'));
    list.addEventListener('drop', (e) => {
      e.preventDefault();
      list.classList.remove('drag-over');

      if(e.dataTransfer.files && e.dataTransfer.files.length){
        const f = e.dataTransfer.files[0];
        if(f.type.startsWith('image/')){
          readDroppedImage(f, (dataUrl) => {
            state[activeGroup].push({ id: uid(), text: 'New task', status: statusKey, image: dataUrl, priority: 'medium' });
            renderBoard();
          });
        }
        return;
      }

      const id = e.dataTransfer.getData('text/plain');
      if(!id) return;
      const arr = state[activeGroup];
      const idx = arr.findIndex(t => t.id === id);
      if(idx === -1) return;
      const [task] = arr.splice(idx, 1);
      task.status = statusKey;

      const taskEls = [...list.querySelectorAll('.task')];
      let visualIndex = taskEls.length;
      for(let i=0;i<taskEls.length;i++){
        const rect = taskEls[i].getBoundingClientRect();
        if(e.clientY < rect.top + rect.height/2){ visualIndex = i; break; }
      }

      let seen = 0, insertAt = arr.length;
      for(let i=0;i<arr.length;i++){
        if(arr[i].status === statusKey){
          if(seen === visualIndex){ insertAt = i; break; }
          seen++;
        }
      }
      arr.splice(insertAt, 0, task);
      renderBoard();
    });
  }

  function removeTaskAnimated(task){
    const el = columnsEl.querySelector('.task[data-id="' + task.id + '"]');
    if(el){
      el.classList.add('removing');
      setTimeout(() => {
        state[activeGroup] = state[activeGroup].filter(t => t.id !== task.id);
        renderBoard();
      }, 220);
    } else {
      state[activeGroup] = state[activeGroup].filter(t => t.id !== task.id);
      renderBoard();
    }
  }

  function buildTaskEl(task){
    if(!task.priority) task.priority = 'medium';
    const el = document.createElement('div');
    el.className = 'task status-' + task.status;
    el.draggable = true;
    el.dataset.id = task.id;
    el.style.borderLeftColor = PRIORITY_META[task.priority].color;

    el.addEventListener('dragstart', (e) => {
      el.classList.add('dragging');
      e.dataTransfer.setData('text/plain', task.id);
      e.dataTransfer.effectAllowed = 'move';
    });
    el.addEventListener('dragend', () => el.classList.remove('dragging'));

    const handle = document.createElement('div');
    handle.className = 'handle';
    handle.textContent = '⠿';
    el.appendChild(handle);

    const body = document.createElement('div');
    body.className = 'task-body';

    const badgeRow = document.createElement('div');
    badgeRow.className = 'badge-row';

    const priPill = document.createElement('button');
    priPill.className = 'priority-pill';
    priPill.title = 'Click to change priority';
    priPill.style.color = PRIORITY_META[task.priority].color;
    priPill.style.borderColor = PRIORITY_META[task.priority].color;
    priPill.innerHTML = '<span class="flag-dot" style="background:' + PRIORITY_META[task.priority].color + '"></span>' + PRIORITY_META[task.priority].label;
    priPill.addEventListener('click', () => {
      const idx = PRIORITY_ORDER.indexOf(task.priority);
      task.priority = PRIORITY_ORDER[(idx + 1) % PRIORITY_ORDER.length];
      renderBoard();
    });
    badgeRow.appendChild(priPill);

    if(task.source === 'github' || task.source === 'classroom'){
      const badge = document.createElement('div');
      badge.className = 'task-badge';
      badge.textContent = task.source === 'github' ? '🐙 GitHub' : '🎓 Classroom';
      badgeRow.appendChild(badge);
    }

    body.appendChild(badgeRow);

    const text = document.createElement('div');
    text.className = 'task-text';
    text.textContent = task.text;
    text.addEventListener('click', () => {
      if(text.getAttribute('contenteditable') === 'true') return;
      startEdit();
    });
    body.appendChild(text);

    function startEdit(){
      text.setAttribute('contenteditable', 'true');
      text.focus();
      placeCaretAtEnd(text);
      const finish = () => {
        text.removeAttribute('contenteditable');
        const newVal = text.textContent.trim();
        task.text = newVal.length ? newVal : task.text;
        text.textContent = task.text;
        text.removeEventListener('blur', finish);
        text.removeEventListener('keydown', onKey);
      };
      const onKey = (e) => {
        if(e.key === 'Enter'){ e.preventDefault(); text.blur(); }
        if(e.key === 'Escape'){ text.textContent = task.text; text.blur(); }
      };
      text.addEventListener('blur', finish);
      text.addEventListener('keydown', onKey);
    }

    if(task.image){
      const img = document.createElement('img');
      img.className = 'task-img';
      img.src = task.image;
      img.addEventListener('click', () => openLightbox(task.image));
      body.appendChild(img);
    }

    el.appendChild(body);

    const actions = document.createElement('div');
    actions.className = 'task-actions';

    const editBtn = document.createElement('button');
    editBtn.className = 'icon-btn';
    editBtn.title = 'Edit';
    editBtn.textContent = '✎';
    editBtn.addEventListener('click', startEdit);
    actions.appendChild(editBtn);

    if(task.url){
      const linkBtn = document.createElement('button');
      linkBtn.className = 'icon-btn';
      linkBtn.title = 'Open on GitHub';
      linkBtn.textContent = '↗';
      linkBtn.addEventListener('click', () => window.open(task.url, '_blank', 'noopener'));
      actions.appendChild(linkBtn);
    }

    const taskImgBtn = document.createElement('button');
    taskImgBtn.className = 'icon-btn';
    taskImgBtn.title = task.image ? 'Replace image' : 'Add image';
    taskImgBtn.textContent = '🖼';
    taskImgBtn.addEventListener('click', () => {
      pickImage((dataUrl) => { task.image = dataUrl; renderBoard(); });
    });
    actions.appendChild(taskImgBtn);

    if(task.image){
      const removeImgBtn = document.createElement('button');
      removeImgBtn.className = 'icon-btn';
      removeImgBtn.title = 'Remove image';
      removeImgBtn.textContent = '⤫';
      removeImgBtn.addEventListener('click', () => { task.image = null; renderBoard(); });
      actions.appendChild(removeImgBtn);
    }

    const removeBtn = document.createElement('button');
    removeBtn.className = 'icon-btn remove';
    removeBtn.title = 'Delete';
    removeBtn.textContent = '🗑';
    removeBtn.addEventListener('click', () => removeTaskAnimated(task));
    actions.appendChild(removeBtn);

    el.appendChild(actions);

    el.addEventListener('dragover', (e) => {
      if(e.dataTransfer.types.includes('Files')) e.preventDefault();
    });
    el.addEventListener('drop', (e) => {
      if(e.dataTransfer.files && e.dataTransfer.files.length){
        e.preventDefault();
        e.stopPropagation();
        const f = e.dataTransfer.files[0];
        if(f.type.startsWith('image/')){
          readDroppedImage(f, (dataUrl) => { task.image = dataUrl; renderBoard(); });
        }
      }
    });

    return el;
  }

  function placeCaretAtEnd(el){
    const range = document.createRange();
    range.selectNodeContents(el);
    range.collapse(false);
    const sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }

  function openLightbox(src){
    document.getElementById('lightbox-img').src = src;
    document.getElementById('lightbox').classList.add('open');
  }
  document.getElementById('lightbox').addEventListener('click', () => {
    document.getElementById('lightbox').classList.remove('open');
  });

  // ---------- expanding add control ----------
  function buildAddControl(statusKey){
    const wrap = document.createElement('div');
    wrap.className = 'add-control';

    const plus = document.createElement('button');
    plus.className = 'add-plus';
    plus.textContent = '+';
    plus.title = 'Add task';
    wrap.appendChild(plus);

    const fields = document.createElement('div');
    fields.className = 'add-fields';

    const input = document.createElement('input');
    input.type = 'text';
    input.placeholder = 'Add a task…';
    fields.appendChild(input);

    let pendingImage = null;
    let pendingPriority = 'medium';

    const priBtn = document.createElement('button');
    priBtn.title = 'Priority: Medium (click to change)';
    priBtn.textContent = '🚩';
    priBtn.style.color = PRIORITY_META[pendingPriority].color;
    priBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = PRIORITY_ORDER.indexOf(pendingPriority);
      pendingPriority = PRIORITY_ORDER[(idx + 1) % PRIORITY_ORDER.length];
      priBtn.style.color = PRIORITY_META[pendingPriority].color;
      priBtn.title = 'Priority: ' + PRIORITY_META[pendingPriority].label + ' (click to change)';
    });
    fields.appendChild(priBtn);

    const imgBtn = document.createElement('button');
    imgBtn.textContent = '🖼';
    imgBtn.title = 'Attach image';
    imgBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      pickImage((dataUrl) => {
        pendingImage = dataUrl;
        confirmBtn.classList.add('pending-img');
      });
    });
    fields.appendChild(imgBtn);

    const confirmBtn = document.createElement('button');
    confirmBtn.className = 'confirm-btn';
    confirmBtn.textContent = '✓';
    confirmBtn.title = 'Add';
    confirmBtn.addEventListener('click', (e) => { e.stopPropagation(); commit(); });
    fields.appendChild(confirmBtn);

    wrap.appendChild(fields);

    function expand(){
      wrap.classList.add('expanded');
      setTimeout(() => input.focus(), 180);
    }
    function collapse(){
      wrap.classList.remove('expanded');
      input.value = '';
      pendingImage = null;
      pendingPriority = 'medium';
      priBtn.style.color = PRIORITY_META.medium.color;
      priBtn.title = 'Priority: Medium (click to change)';
      confirmBtn.classList.remove('pending-img');
    }
    function commit(){
      const val = input.value.trim();
      if(!val && !pendingImage){ collapse(); return; }
      state[activeGroup].push({
        id: uid(),
        text: val || 'Untitled task',
        status: statusKey,
        image: pendingImage,
        priority: pendingPriority
      });
      collapse();
      renderBoard();
    }

    plus.addEventListener('click', () => {
      if(wrap.classList.contains('expanded')) collapse();
      else expand();
    });
    input.addEventListener('keydown', (e) => {
      if(e.key === 'Enter') commit();
      if(e.key === 'Escape') collapse();
    });
    input.addEventListener('blur', () => {
      setTimeout(() => {
        if(!wrap.contains(document.activeElement)) collapse();
      }, 120);
    });

    return wrap;
  }
})();
</script>

